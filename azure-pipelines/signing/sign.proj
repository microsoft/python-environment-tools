<?xml version="1.0" encoding="utf-8"?>
<!--
  Signs files in place with MicroBuild (ESRP).

  Run after the MicroBuildSigningPlugin task and a NuGet restore of packages.config:
    msbuild sign.proj /p:SignType=real /p:FileToSign=<full path or wildcard> /p:Authenticode=<certificate> [/p:MacAppName=<name>] [/p:OutDir=<common parent>]

  A wildcard FileToSign (for example `macos/*/pet.zip`) signs every match in one MicroBuild operation;
  pass OutDir as a common parent of the matches.

  Certificates used by azure-pipelines/templates/rust-package.yml:
    Microsoft400        Windows Authenticode (pet.exe)
    MacDeveloperHarden  macOS hardened-runtime signing (zip containing `pet`)
    8020                macOS notarization (same zip, after MacDeveloperHarden)
-->
<Project DefaultTargets="SignFiles" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MicroBuildCoreDir>$(MSBuildThisFileDirectory)packages\Microsoft.VisualStudioEng.MicroBuild.Core.1.0.0\build\</MicroBuildCoreDir>
    <!-- MicroBuild only signs files located under OutDir. -->
    <OutDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetDirectoryName('$(FileToSign)'))))</OutDir>
    <IntermediateOutputPath>$(OutDir)signing-obj\</IntermediateOutputPath>
  </PropertyGroup>

  <Import Project="$(MicroBuildCoreDir)Microsoft.VisualStudioEng.MicroBuild.Core.props" Condition="Exists('$(MicroBuildCoreDir)Microsoft.VisualStudioEng.MicroBuild.Core.props')" />

  <ItemGroup>
    <FilesToSign Include="$(FileToSign)" Condition="'$(FileToSign)' != ''">
      <Authenticode>$(Authenticode)</Authenticode>
      <MacAppName Condition="'$(MacAppName)' != ''">$(MacAppName)</MacAppName>
    </FilesToSign>
  </ItemGroup>

  <Target Name="ValidateSigningInputs" BeforeTargets="SignFiles">
    <Error Condition="!Exists('$(MicroBuildCoreDir)Microsoft.VisualStudioEng.MicroBuild.Core.targets')" Text="MicroBuild signing targets are missing. Restore azure-pipelines/signing/packages.config before signing." />
    <Error Condition="'$(SignType)' != 'real' and '$(SignType)' != 'test'" Text="SignType must be 'real' or 'test'." />
    <Error Condition="'@(FilesToSign)' == ''" Text="FileToSign does not exist: '$(FileToSign)'." />
    <Error Condition="!Exists('%(FilesToSign.FullPath)')" Text="FileToSign does not exist: '%(FilesToSign.Identity)'." />
    <Error Condition="'$(Authenticode)' == ''" Text="Authenticode (certificate name) is required." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
  </Target>

  <Import Project="$(MicroBuildCoreDir)Microsoft.VisualStudioEng.MicroBuild.Core.targets" Condition="Exists('$(MicroBuildCoreDir)Microsoft.VisualStudioEng.MicroBuild.Core.targets')" />
</Project>
